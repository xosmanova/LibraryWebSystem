@model IEnumerable<LibraryManagementSystem.Models.Member>
@{
    ViewData["Title"] = "Members";
}

<div class="members-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">Members</h4>
            <p class="text-muted small mb-0">Manage registered library members and access</p>
        </div>
        <button type="button" class="btn btn-teal" data-bs-toggle="modal" data-bs-target="#addMemberModal">
            <i class="bi bi-person-plus-fill me-1"></i> Add Member
        </button>
    </div>

    <!-- Stat cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card card-green">
                <div class="stat-icon icon-green"><i class="bi bi-people-fill"></i></div>
                <div class="stat-value">@(ViewBag.TotalMembers ?? 44)</div>
                <div class="stat-label">Total Members</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card card-cyan">
                <div class="stat-icon icon-cyan"><i class="bi bi-person-check-fill"></i></div>
                <div class="stat-value">@(ViewBag.ActiveMembers ?? 41)</div>
                <div class="stat-label">Active Members</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card card-red">
                <div class="stat-icon icon-red"><i class="bi bi-person-x-fill"></i></div>
                <div class="stat-value">@(ViewBag.SuspendedMembers ?? 3)</div>
                <div class="stat-label">Suspended Members</div>
            </div>
        </div>
    </div>

    <!-- Search bar -->
    <div class="custom-card mb-4 p-3">
        <form method="get" asp-action="Index" class="row g-2">
            <div class="col-md-10">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control border-start-0" placeholder="Search by name, email or phone..." />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-dark w-100"><i class="bi bi-funnel me-1"></i> Search</button>
            </div>
        </form>
    </div>

    <!-- Members Table -->
    <div class="custom-card">
        <div class="table-responsive">
            <table class="table table-modern align-middle mb-0">
                <thead>
                    <tr>
                        <th>Member ID</th>
                        <th>Member Name</th>
                        <th>Contact</th>
                        <th>Membership Plan</th>
                        <th>Books Borrowed</th>
                        <th>Join Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#MB-@m.Id.ToString("D4")</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@(string.IsNullOrEmpty(m.AvatarUrl) ? "/images/avatars/avatar1.svg" : m.AvatarUrl)" alt="@m.FullName" class="avatar-sm" />
                                    <div>
                                        <span class="fw-bold text-dark d-block">@m.FullName</span>
                                        <small class="text-muted">@m.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td>@m.Phone</td>
                            <td>
                                @if (m.MembershipType == "Faculty")
                                {
                                    <span class="badge bg-purple text-white" style="background-color: #6f42c1;">Faculty</span>
                                }
                                else if (m.MembershipType == "Premium")
                                {
                                    <span class="badge bg-warning text-dark">Premium</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">Student</span>
                                }
                            </td>
                            <td><strong class="text-primary">@m.BooksBorrowed</strong></td>
                            <td class="text-muted small">@m.JoinedDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (m.Status == "Active")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Suspended</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Add Member -->
<div class="modal fade" id="addMemberModal" tabindex="-1" aria-labelledby="addMemberModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="addMemberModalLabel">Add New Member</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Full Name</label>
                        <input type="text" name="FullName" required class="form-control" placeholder="Member full name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Email Address</label>
                        <input type="email" name="Email" required class="form-control" placeholder="name@domain.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Phone Number</label>
                        <input type="text" name="Phone" class="form-control" placeholder="+1 (555) 000-0000" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Membership Plan</label>
                        <select name="MembershipType" class="form-select">
                            <option value="Student">Student</option>
                            <option value="Faculty">Faculty</option>
                            <option value="Premium">Premium</option>
                            <option value="Standard">Standard</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-teal">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
