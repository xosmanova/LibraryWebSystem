<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                <div class="brand-icon">
                    <i class="fa-solid fa-book-open-reader"></i>
                </div>
                <div class="brand-text">
                    <span class="brand-title">Library System</span>
                    <span class="brand-subtitle">Book Lovers</span>
                </div>
            </div>

            <div class="sidebar-menu">
                <div class="menu-label">MAIN MENU</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" 
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <span>Dashboards</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Books" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" 
                           asp-controller="Books" asp-action="Index">
                            <i class="bi bi-journal-bookmark-fill"></i>
                            <span>Books List</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Books" && ViewContext.RouteData.Values["Action"]?.ToString() == "Create" ? "active" : "")" 
                           asp-controller="Books" asp-action="Create">
                            <i class="bi bi-plus-circle-fill"></i>
                            <span>Add a Book</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index" fragment="circulation">
                            <i class="bi bi-book-half"></i>
                            <span>Books Circulation</span>
                        </a>
                    </li>
                </ul>

                <div class="menu-label mt-3">MANAGEMENT</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Members" ? "active" : "")" 
                           asp-controller="Members" asp-action="Index">
                            <i class="bi bi-people-fill"></i>
                            <span>Members</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Publishers" ? "active" : "")" 
                           asp-controller="Publishers" asp-action="Index">
                            <i class="bi bi-building"></i>
                            <span>Publishers</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Authors" ? "active" : "")" 
                           asp-controller="Authors" asp-action="Index">
                            <i class="bi bi-person-lines-fill"></i>
                            <span>Authors</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Roles" ? "active" : "")" 
                           asp-controller="Roles" asp-action="Index">
                            <i class="bi bi-shield-check"></i>
                            <span>Roles & Permission</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Settings" ? "active" : "")" 
                           asp-controller="Settings" asp-action="Index">
                            <i class="bi bi-gear-fill"></i>
                            <span>Settings</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="sidebar-footer">
                <div class="user-chip">
                    <img src="~/images/admin.png" alt="Avatar" class="avatar-sm">
                    <div class="user-info">
                        <span class="user-name">Admin</span>
                        <span class="user-role">System Administrator</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="main-wrapper">
            <!-- Top Navbar -->
            <header class="top-navbar">
                <div class="navbar-left d-flex align-items-center">
                    <button class="btn btn-sm btn-light d-md-none me-2" id="sidebarToggle">
                        <i class="bi bi-list"></i>
                    </button>
                    <h5 class="page-title mb-0">Library Management System</h5>
                </div>

                <div class="navbar-right d-flex align-items-center">
                    <div class="header-user d-flex align-items-center">
                        <img src="~/images/admin.png" alt="Admin" class="avatar-admin me-2">
                        <span class="admin-name me-3">Admin</span>
                        <a asp-controller="Account" asp-action="Logout" class="logout-btn d-flex align-items-center text-decoration-none" title="Logout">
                            <i class="bi bi-box-arrow-right logout-icon me-1"></i>
                            <span>Logout</span>
                        </a>
                    </div>
                </div>
            </header>

            <!-- Page Body -->
            <main class="page-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="app-footer">
                <div class="container-fluid d-flex justify-content-between align-items-center">
                    <span>Software designed by dalamin</span>
                    <span class="text-muted">developed by another team</span>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
