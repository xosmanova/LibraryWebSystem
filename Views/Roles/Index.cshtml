@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Roles & Permission";
}

<div class="roles-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">Roles & Permission</h4>
            <p class="text-muted small mb-0">System access control, roles and permission privileges</p>
        </div>
        <button class="btn btn-teal">
            <i class="bi bi-shield-plus me-1"></i> Add Role
        </button>
    </div>

    <div class="row g-4">
        @foreach (var r in Model)
        {
            <div class="col-md-6">
                <div class="custom-card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="stat-icon icon-purple mb-0">
                                <i class="bi bi-shield-lock-fill"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-0">@r.Name</h5>
                                <small class="text-muted">@r.UsersCount Active Users</small>
                            </div>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                    </div>

                    <p class="text-muted small mb-3">@r.Description</p>

                    <h6 class="fw-bold small text-dark mb-2">Assigned Permissions:</h6>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @foreach (var p in r.Permissions)
                        {
                            <span class="badge bg-light text-secondary border">
                                <i class="bi bi-check2 text-success me-1"></i> @p
                            </span>
                        }
                    </div>

                    <div class="border-top pt-3 text-end">
                        <button class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-gear me-1"></i> Edit Permissions
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
