@model IEnumerable<LibraryManagementSystem.Models.Publisher>
@{
    ViewData["Title"] = "Publishers";
}

<div class="publishers-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">Publishers</h4>
            <p class="text-muted small mb-0">Registered publisher houses and partners</p>
        </div>
        <button type="button" class="btn btn-teal" data-bs-toggle="modal" data-bs-target="#addPublisherModal">
            <i class="bi bi-building-add me-1"></i> Add Publisher
        </button>
    </div>

    <div class="row g-4 mb-4">
        @foreach (var p in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="custom-card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="stat-icon icon-cyan mb-0">
                            <i class="bi bi-building"></i>
                        </div>
                        <span class="badge bg-light text-dark border">@p.Country</span>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">@p.Name</h5>
                    <p class="text-muted small mb-3">Established: <strong>@p.EstablishedYear</strong></p>

                    <div class="bg-light p-3 rounded-3 small mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Books in Collection:</span>
                            <strong class="text-primary">@p.TotalBooks</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Email:</span>
                            <span>@p.Email</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Phone:</span>
                            <span>@p.Phone</span>
                        </div>
                    </div>

                    <small class="text-muted d-block"><i class="bi bi-geo-alt me-1"></i> @p.Address</small>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal: Add Publisher -->
<div class="modal fade" id="addPublisherModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">New Publisher</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Publisher Name</label>
                        <input type="text" name="Name" required class="form-control" placeholder="Publisher name" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Country</label>
                        <input type="text" name="Country" required class="form-control" placeholder="Country" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Contact Email</label>
                            <input type="email" name="Email" class="form-control" placeholder="info@publisher.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Established Year</label>
                            <input type="number" name="EstablishedYear" value="2000" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Address</label>
                        <input type="text" name="Address" class="form-control" placeholder="City and address" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-teal">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>
