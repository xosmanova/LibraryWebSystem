@model LibraryManagementSystem.Models.Book
@{
    ViewData["Title"] = "Book Details";
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="custom-card p-4 p-md-5">
            <div class="row g-4">
                <!-- Book Cover Preview -->
                <div class="col-md-4 text-center">
                    <img src="@(string.IsNullOrEmpty(Model.CoverImageUrl) ? "/images/covers/book1001.svg" : Model.CoverImageUrl)" 
                         alt="@Model.Title" class="img-fluid rounded-3 shadow mb-3" style="max-height: 340px; object-fit: cover;" />
                    
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil-square me-1"></i> Edit Book
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                            <i class="bi bi-trash3 me-1"></i> Delete
                        </a>
                        <a asp-action="Index" class="btn btn-light border">
                            <i class="bi bi-arrow-left me-1"></i> Return to List
                        </a>
                    </div>
                </div>

                <!-- Book Information -->
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-secondary">#@Model.Id</span>
                        <span class="badge bg-primary">@Model.Category</span>
                        @if (Model.Status == "Available")
                        {
                            <span class="badge bg-success">Available</span>
                        }
                        else if (Model.Status == "Issued")
                        {
                            <span class="badge bg-info text-dark">Issued</span>
                        }
                        else if (Model.Status == "Reserved")
                        {
                            <span class="badge bg-warning text-dark">Reserved</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Overdue</span>
                        }

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border">Inactive</span>
                        }
                    </div>

                    <h2 class="fw-bold text-dark mb-1">@Model.Title</h2>
                    @if (!string.IsNullOrEmpty(Model.AlternateTitle))
                    {
                        <h6 class="text-muted fst-italic mb-3">@Model.AlternateTitle</h6>
                    }
                    else
                    {
                        <div class="mb-3"></div>
                    }

                    <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                        <div class="row g-3 small">
                            <div class="col-6">
                                <span class="text-muted d-block">Author:</span>
                                <strong class="fs-6 text-dark">@Model.Author</strong>
                            </div>
                            <div class="col-6">
                                <span class="text-muted d-block">Publisher:</span>
                                <strong class="fs-6 text-dark">@(string.IsNullOrEmpty(Model.Publisher) ? "N/A" : Model.Publisher)</strong>
                            </div>
                            <div class="col-6">
                                <span class="text-muted d-block">Copies Available:</span>
                                <strong class="fs-6 text-dark">@Model.CopiesAvailable copies</strong>
                            </div>
                            <div class="col-6">
                                <span class="text-muted d-block">Price / Fee:</span>
                                <strong class="fs-6 text-dark">@(Model.Price > 0 ? Model.Price.ToString("N2") + " ₼" : "Free")</strong>
                            </div>
                            <div class="col-6">
                                <span class="text-muted d-block">Language:</span>
                                <strong class="fs-6 text-dark">@(string.IsNullOrEmpty(Model.Language) ? "English" : Model.Language)</strong>
                            </div>
                            <div class="col-6">
                                <span class="text-muted d-block">Cataloged Date:</span>
                                <strong class="fs-6 text-dark">@Model.CreatedAt.ToString("MMM dd, yyyy")</strong>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark mb-2">Description</h5>
                    <p class="text-muted" style="line-height: 1.7;">
                        @(string.IsNullOrEmpty(Model.Description) ? "No synopsis available for this title." : Model.Description)
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
