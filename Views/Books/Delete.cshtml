@model LibraryManagementSystem.Models.Book
@{
    ViewData["Title"] = "Delete Book";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="custom-card p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="text-danger mb-3">
                    <i class="bi bi-exclamation-triangle-fill" style="font-size: 3.5rem;"></i>
                </div>
                <h3 class="fw-bold text-dark">Delete Book</h3>
                <p class="text-muted">Are you sure you want to remove this book from the library catalog? This action cannot be undone.</p>
            </div>

            <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                <div class="d-flex align-items-center gap-3">
                    <img src="@(string.IsNullOrEmpty(Model.CoverImageUrl) ? "/images/covers/book1001.svg" : Model.CoverImageUrl)" 
                         alt="@Model.Title" class="book-thumb" style="width: 55px; height: 75px;" />
                    <div>
                        <h5 class="fw-bold text-dark mb-1">@Model.Title</h5>
                        <p class="text-muted mb-0 small">
                            Author: <strong>@Model.Author</strong> | Category: <strong>@Model.Category</strong>
                        </p>
                        <p class="text-muted mb-0 small">
                            Available Copies: <strong>@Model.CopiesAvailable</strong> | Status: <strong>@Model.Status</strong>
                        </p>
                    </div>
                </div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex justify-content-center gap-3">
                <button type="submit" class="btn btn-danger px-4 py-2 fw-semibold">
                    <i class="bi bi-trash3-fill me-1"></i> Delete Book
                </button>
                <a asp-action="Index" class="btn btn-secondary px-4 py-2">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>
